# Environment variables for mainframe.
# Copy to ~/.env and fill in your values.
# Source with: source ~/.env

# GitHub (required for cloning repos and pushing)
export GH_TOKEN="ghp_..."

# Tailscale (required for private network access)
export TAILSCALE_AUTHKEY="tskey-auth-..."

# Mainframe hardening (default: true, strongly recommended)
export HARDEN_ENABLED="true"

# Sane defaults (all enabled by default, disable individually if needed):
export HARDEN_SSH_CRYPTO="true"      # Modern KEX/ciphers/MACs, ed25519 host key
export HARDEN_BBR="true"             # BBR TCP congestion control
export HARDEN_APPARMOR="true"        # AppArmor check
export HARDEN_UNATTENDED="true"      # Unattended security updates
export HARDEN_NEEDRESTART="true"     # Auto-restart services after updates
export HARDEN_SWAP="true"            # 2GB swap file
export HARDEN_JOURNALD="true"        # Cap journald at 500MB
export HARDEN_ETCKEEPER="true"       # Track /etc in git
export HARDEN_DEADMAN="true"         # Auto-rollback safety net
export HARDEN_FAIL2BAN="true"        # Brute-force protection

# Optional extras (disabled by default, enable if needed):
# export HARDEN_FIDO2="false"        # FIDO2 hardware keys
# export HARDEN_TOTP="false"         # TOTP 2FA
# export HARDEN_VPN_ONLY="false"     # SSH only via VPN
# export HARDEN_AUDITD="false"       # auditd file integrity
# export HARDEN_AIDE="false"         # AIDE file integrity
# export HARDEN_NOEXEC_SHM="false"   # /dev/shm noexec
# export HARDEN_CORE_DUMPS="false"   # Disable core dumps

# Bitwarden (optional, for secret management)
export BW_EMAIL="your@email.com"

# Contabo API (optional, for VPS management)
export CONTABO_CLIENT_ID="INT-..."
export CONTABO_CLIENT_SECRET="..."
export CONTABO_API_USER="your@email.com"
export CONTABO_API_PASSWORD="..."

# VPS name (default: mainframe)
export VPS_NAME="mainframe"

# Base code directory (default: /code)
export BASE_DIR="/code"

# Kit stack ref (for anywaye dev)
export KIT_STACK_REF="e20d20664e6f1dc0bfb1023874367d2be43370d5"
export KIT_POSTGRES_DATABASES="identity,ship,ella,cafe,core,courier,billing,gateway,keyholder,kit,loom,notes,oauth-stub,platform,press,website,docs,anywaye-py,anywaye-rb,anywaye-ts,box,darkroom"
export COURIER_TOKEN="dummy"